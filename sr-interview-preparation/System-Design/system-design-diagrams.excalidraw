    {
      "id": "IrIltf-7SBQky8EUpRv1c",
      "type": "text",
      "x": 5316.063143408667,
      "y": -958.1240000757601,
      "width": 370.99169921875,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "BZ92UFCJO9kjJeqF9UnBX",
      "index": "b2mV",
      "roundness": null,
      "seed": 2105673076,
      "version": 498,
      "versionNonce": 406622324,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778722926835,
      "link": null,
      "locked": false,
      "text": "- The standby database will be replicated in\nreal time. \n\n- We can use that standby database as\nanother read source. \n\n- If the connection is lost with the primary DB\nthen we can switch and start reading directly\nfrom the replicated database. \n\nDifference with Warm\n- We are doing the replication in real time so\nthere is no delay. ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "i3rHrYOKUOfMfTF98MFga",
      "originalText": "- The standby database will be replicated in real time. \n\n- We can use that standby database as another read source. \n\n- If the connection is lost with the primary DB then we can switch and start reading directly from the replicated database. \n\nDifference with Warm\n- We are doing the replication in real time so there is no delay. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
