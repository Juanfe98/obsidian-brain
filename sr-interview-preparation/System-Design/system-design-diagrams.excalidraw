    {
      "type": "rectangle",
      "version": 2197,
      "versionNonce": 713098532,
      "isDeleted": false,
      "id": "OtVvlUhNmlVsfX8YNTbAf",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 157.20092687739452,
      "y": -1059.4042556347517,
      "strokeColor": "#000000",
      "backgroundColor": "#eeeeee",
      "width": 262.20130657658194,
      "height": 425.2885680379747,
      "seed": 870161948,
      "groupIds": [],
      "index": "a6Z",
      "frameId": "fBkCU9y164gwrAM0F4lu8",
      "roundness": null,
      "boundElements": [
        {
          "type": "text",
          "id": "brl9QAu6uK54YkycZAhxG"
        }
      ],
      "updated": 1778692210940,
      "link": null,
      "locked": false
    },
    {
      "id": "brl9QAu6uK54YkycZAhxG",
      "type": "text",
      "x": 162.20092687739452,
      "y": -1054.4042556347517,
      "width": 252.16690063476562,
      "height": 404.3318927044903,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "fBkCU9y164gwrAM0F4lu8",
      "index": "a6d",
      "roundness": null,
      "seed": 322665116,
      "version": 1299,
      "versionNonce": 636272804,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778692210940,
      "link": null,
      "locked": false,
      "text": "Better but still not good\nenough. \n\nReal Benefit: We can scale\nthe http server and the\ndatabase server\nindependently.\n\nSo if there is data\nintensive operations we are\nnot affecting the CPU\nfrom the http server.\n\n! Still, both of them are\nsingle point of failures.\n- Web server goes down,\nthe website goes down!",
      "fontSize": 19.02738318609366,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "OtVvlUhNmlVsfX8YNTbAf",
      "originalText": "Better but still not good enough. \n\nReal Benefit: We can scale the http server and the database server independently.\n\nSo if there is data intensive operations we are not affecting the CPU from the http server.\n\n! Still, both of them are single point of failures.\n- Web server goes down, the website goes down!",
      "autoResize": true,
      "lineHeight": 1.25
    },
