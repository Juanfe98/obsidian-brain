    {
      "id": "pEycLEyCRmGC5QDyvipIO",
      "type": "text",
      "x": 415.6583266484835,
      "y": 411.4951569393814,
      "width": 342.99169921875,
      "height": 206.18592140477006,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "r7tymvM-CWpZu4TLJ70BS"
      ],
      "frameId": "4dNgHyl-8Fgo1KhYG5Exf",
      "index": "b0jxV",
      "roundness": null,
      "seed": 409825828,
      "version": 214,
      "versionNonce": 321464348,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778699068746,
      "link": null,
      "locked": false,
      "text": "Web servers needs to be stateless.\n\n- We cannot assume that our server will\nknow anything about previous requests. \n\n- Each call the LB will route traffic to\nprobably different servers.\n\n- We can of course save information in the\ndatabase.",
      "fontSize": 16.494873712381604,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "5ryI68Or2HgwaySDzRZrj",
      "originalText": "Web servers needs to be stateless.\n\n- We cannot assume that our server will know anything about previous requests. \n\n- Each call the LB will route traffic to probably different servers.\n\n- We can of course save information in the database.",
      "autoResize": true,
      "lineHeight": 1.25
    },
