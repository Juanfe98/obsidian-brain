    {
      "id": "o3X4Te22PtjF4xO9u17nR",
      "type": "text",
      "x": -1036.7040544701654,
      "y": -937.1218085628142,
      "width": 219.54762268066406,
      "height": 261.62651880878786,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
