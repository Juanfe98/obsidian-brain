    {
      "id": "wwsLIV8x_kzvAlIq5uVeJ",
      "type": "text",
      "x": 433.816908692329,
      "y": -223.03999598154078,
      "width": 347.39166259765625,
      "height": 380,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "4dNgHyl-8Fgo1KhYG5Exf",
      "index": "b0Al",
      "roundness": null,
      "seed": 566934300,
      "version": 3384,
      "versionNonce": 1440087076,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778698653603,
      "link": null,
      "locked": false,
      "text": "This is how complex systems are designed\ntoday. \n\nIt allows the system to grow as you can\nkeep adding servers. \n\nThe load balancer takes a big relevance here\nas it will be in charge of distribute the\nrequests among the available servers. \n\nLB can work with different algorithms some\nof them are: \n- Randomly picking the server. \n- Based on the server capacity and try to\nroute traffic inteligently.\n\nIf a server is down, the load balancer will\nnoticed that and route the traffic to the\nothers servers. ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "xLjJOq12P8ZZqHO03Gxfz",
      "originalText": "This is how complex systems are designed today. \n\nIt allows the system to grow as you can keep adding servers. \n\nThe load balancer takes a big relevance here as it will be in charge of distribute the requests among the available servers. \n\nLB can work with different algorithms some of them are: \n- Randomly picking the server. \n- Based on the server capacity and try to route traffic inteligently.\n\nIf a server is down, the load balancer will noticed that and route the traffic to the others servers. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
