      ],
      "frameId": "X2pNp3U6uMI2Zw5hQgL_L",
      "index": "a4zt",
      "roundness": null,
      "seed": 602617892,
      "version": 558,
      "versionNonce": 1077205020,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778691561797,
      "link": null,
      "locked": false,
      "text": "Main issue of this\napproach, there is a\nsingle point of failure.\n\nIf the server goes\ndown, everything goes\ndown. \n\nWe'll have to fix it\nquick or provision a new\nserver in the meantime.",
      "fontSize": 19.02738318609366,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "sVlX8Ci22K8MiY815wU7R",
      "originalText": "Main issue of this approach, there is a single point of failure.\n\nIf the server goes down, everything goes down. \n\nWe'll have to fix it quick or provision a new server in the meantime.",
      "autoResize": true,
      "lineHeight": 1.25
    },
