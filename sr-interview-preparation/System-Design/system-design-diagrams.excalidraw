      "link": null,
      "locked": false
    },
    {
      "id": "RZms-7qGhmOHUhGAQ_CpM",
      "type": "text",
      "x": 2846.7483945158333,
      "y": 264.89564781025405,
      "width": 447.215576171875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "FfGcaRx04PoKDXOcsWsoF"
      ],
      "frameId": "vkYdCFYZ4tZ4MvCAiFID_",
      "index": "b4C",
      "roundness": null,
      "seed": 1322266868,
      "version": 676,
      "versionNonce": 337594100,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778731080022,
      "link": null,
      "locked": false,
      "text": "- Re-Sharding might be complex cause adding a new\nserver (shard) will require to re-distribute the data. How\ndo i figure out what data gets send to the new host\nand get removed from the other host?  \n\n- HotSpots (Celebrity problem), the way we distribute\nthe data across shards it has to keep in mind the\ntraffic. If there is one shard containing information that\nwill be query a lot, then we might need to think about\nthat when distributing. ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "vjI8oVQqaanpLWXJGeih8",
      "originalText": "- Re-Sharding might be complex cause adding a new server (shard) will require to re-distribute the data. How do i figure out what data gets send to the new host and get removed from the other host?  \n\n- HotSpots (Celebrity problem), the way we distribute the data across shards it has to keep in mind the traffic. If there is one shard containing information that will be query a lot, then we might need to think about that when distributing. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vkYdCFYZ4tZ4MvCAiFID_",
      "type": "frame",
      "x": 1893.1931196380633,
      "y": -277.62808855881985,
      "width": 1422.3074114044796,
      "height": 763.0170934320579,
